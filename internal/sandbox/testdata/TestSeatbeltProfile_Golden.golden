(version 1)
(allow default)
(allow file-read*)
(deny file-write*)
(allow file-write* (subpath "<ROOT>/project"))
(allow file-write* (subpath "<ROOT>/extra"))
(allow file-write* (subpath "<ROOT>/cache"))
(allow file-write* (subpath "/dev/null"))
(deny file-write* (subpath "<ROOT>/project/.git/config"))
(deny file-write* (subpath "<ROOT>/project/.git/hooks"))
(deny file-write* (subpath "<ROOT>/project/crushrc"))
(deny file-write* (subpath "<ROOT>/project/secrets"))
